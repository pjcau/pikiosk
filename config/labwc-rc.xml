<?xml version="1.0"?>
<!--
  labwc rc.xml for pikiosk — installed to ~/.config/labwc/rc.xml by install.sh
  (always) and by scripts/apply-remote.sh.

  Back key of the IR remote: the kernel emits KEY_BACK (XF86Back), but Chromium on
  Wayland does not treat it as "history back". labwc grabs it here and types
  Alt+Left (Chromium's standard back shortcut) into the focused window via wtype.
-->
<labwc_config>
  <keyboard>
    <default />
    <keybind key="XF86Back">
      <action name="Execute" command="wtype -M alt -k Left -m alt" />
    </keybind>
  </keyboard>
</labwc_config>
