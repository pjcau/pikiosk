#!/usr/bin/env bash
sleep 2

# VNC with automatic restart (survives HDMI changes and disconnections)
(while true; do
  wayvnc 0.0.0.0 5900 2>> /tmp/wayvnc.log
  sleep 3
done) &

sleep 2

# Kiosk with VPN, temperature and WiFi-setup checks.
# __REPO_DIR__ is replaced by install.sh with the actual clone path (run-in-place).
__REPO_DIR__/kiosk/launch-kiosk.sh >> /tmp/kiosk.log 2>&1 &
